# Platform planning DB (MySQL 8). Example:
DATABASE_URL=mysql+pymysql://aymes:YOUR_PASSWORD@localhost:3306/supply_planning?charset=utf8mb4
# Optional: true for many local installs; false (default) when the server requires TLS (e.g. Azure Database for MySQL).
# DATABASE_SSL_DISABLED=true
# ENVIRONMENT=dev   # dev | local | prod — dev/local enable dev auth below
# When running the built SPA from uvicorn (:8000), the browser does not send X-Dev-User.
# Set this so API calls still authenticate (user is created/upserted on first request):
# DEV_DEFAULT_USER_EMAIL=dev@local
# ALLOW_DEMO_DATA=true  # Set only for dev; enables seed scripts. Default: false.

# ---------------------------------------------------------------------------
# MySQL — sales source and forecast tables
# ---------------------------------------------------------------------------
# If MYSQL_PASSWORD is omitted or left empty, the app copies user/password/host/port
# from DATABASE_URL (mysql+pymysql) so you only maintain one set of credentials.
# Set MYSQL_HOST / MYSQL_USER / MYSQL_PORT / MYSQL_PASSWORD here when they must differ
# from DATABASE_URL (e.g. forecast DB on same host with same password — leave these unset).
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=aymes
# MYSQL_PASSWORD=
# MYSQL_DATABASE=aymes_reports
# Optional: separate DB for forecast tables. If omitted, same database as DATABASE_URL is used.
# MYSQL_FORECAST_DATABASE=aymes_forecasting

# ---------------------------------------------------------------------------
# Legacy output MySQL database (aymes_reports on GCP Cloud SQL)
# Leave HOST/PORT/USER/PASSWORD blank to fall back to MYSQL_* above.
# ---------------------------------------------------------------------------
# LEGACY_OUTPUT_MYSQL_HOST=35.233.108.189
# LEGACY_OUTPUT_MYSQL_PORT=3306
# LEGACY_OUTPUT_MYSQL_USER=aymesBI
# LEGACY_OUTPUT_MYSQL_PASSWORD=
# LEGACY_OUTPUT_TARGET_DB=aymes_reports
# LEGACY_OUTPUT_STAGING_TABLE=aymes_demand_planning_forecast_by_model_new
# LEGACY_OUTPUT_LIVE_TABLE=aymes_demand_planning_forecast_by_model
